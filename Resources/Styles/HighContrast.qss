/* HighContrast 主题的界面样式表。
   与 Light.qss 逐条同构，只差色值：选择器、顺序、圆角与尺寸三份保持一致，
   色值同样取自 src/Ui/DesignTokens.h 的 kHighContrastPalette，用例双向核对同解。 */

/* ---- 面：只有具名的根与卡片铺底。裸 QWidget 一律不铺——铺了就是每个子控件各画一块底，
        表单里会排出一条条灰带 ---- */
QWidget#appRoot {
    background-color: #FFFFFF;
}

/* 卡片：设置页的一页、录屏控制条与标注工具栏共用一档形状（悬浮件靠描边与底色分出来，Qt 的样式表没有投影） */
QWidget#pageCard, QWidget#hudRoot, QWidget#AnnotationToolbar {
    background-color: #FFFFFF;
    border: 2px solid #000000;
    border-radius: 12px;
}

/* ---- 文字颜色层级（字号见 applyTextRole） ---- */
QLabel#pageHint {
    color: #000000;
}

QLabel#metricValue {
    color: #000000;
}

QLabel:disabled {
    color: #000000;
}

/* ---- 按钮：中性底 + 一档悬停、一档按下；主按钮（default）走填充主色 ---- */
QPushButton {
    background-color: #FFFFFF;
    color: #000000;
    border: 2px solid #000000;
    border-radius: 8px;
    padding: 0 12px;
    min-height: 28px;
}

QPushButton:hover {
    background-color: #E0E0E0;
}

QPushButton:pressed {
    background-color: #C8C8C8;
}

QPushButton:focus {
    border-color: #0B57D0;
}

QPushButton:disabled {
    background-color: #FFFFFF;
    color: #000000;
    border-color: #000000;
}

QPushButton:default {
    background-color: #0B57D0;
    color: #FFFFFF;
    border-color: #0B57D0;
}

QPushButton:default:hover {
    background-color: #08449E;
    border-color: #08449E;
}

QPushButton:default:pressed {
    background-color: #0B57D0;
}

/* ---- 工具按钮：平时透明，只在悬停/选中时给出底 ---- */
QToolButton {
    background-color: transparent;
    color: #000000;
    border: 2px solid transparent;
    border-radius: 8px;
    padding: 2px;
    min-width: 28px;
    min-height: 28px;
}

QToolButton:hover {
    background-color: #E0E0E0;
}

QToolButton:pressed {
    background-color: #C8C8C8;
}

QToolButton:focus {
    border-color: #0B57D0;
}

QToolButton:checked {
    background-color: #D6E4FB;
    border-color: #0B57D0;
}

QToolButton:disabled {
    background-color: transparent;
    border-color: transparent;
}

/* ---- 输入类：描边比分隔线重一档，好让「能填的」一眼分得出 ---- */
QLineEdit, QComboBox, QSpinBox {
    background-color: #FFFFFF;
    color: #000000;
    border: 2px solid #000000;
    border-radius: 8px;
    padding: 0 8px;
    min-height: 28px;
    selection-background-color: #FFE500;
    selection-color: #000000;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 2px solid #0B57D0;
}

QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled {
    background-color: #FFFFFF;
    color: #000000;
    border-color: #000000;
}

QLineEdit:read-only {
    background-color: #FFFFFF;
    color: #000000;
}

/* ---- 标注窗的行内文字输入框：与上面几档输入框同形，别把识别结果区的宽内边距带进去 ----
   上下内边距为零是标注输入框高度算式的前提（AnnotationView::resizeTextEditorToContent 只补边框与余量），
   改这里的 padding 要同步改那边 */
QTextEdit#annotationTextEditor {
    background-color: #FFFFFF;
    color: #000000;
    border: 2px solid #000000;
    border-radius: 8px;
    padding: 0 8px;
    selection-background-color: #FFE500;
    selection-color: #000000;
}

QTextEdit#annotationTextEditor:focus {
    border: 2px solid #0B57D0;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #000000;
    border: 2px solid #000000;
    border-radius: 8px;
    padding: 4px;
    outline: none;
    selection-background-color: #D6E4FB;
    selection-color: #000000;
}

QComboBox QAbstractItemView::item {
    min-height: 24px;
    border-radius: 6px;
    padding: 0 8px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #E0E0E0;
}

/* 下拉与微调框的箭头刻意不在这里出现：给 ::drop-down / ::up-button 写过规则之后，
   原生风格就不再画箭头了——界面只剩一个空白方块，用户看不出这一格能点。
   箭头由原生风格按 QPalette 画，深浅两档都跟着走。 */
/* 勾选框自己画：不覆盖 ::indicator 时，原生风格按系统深浅色画那枚方框，
   应用切成深色而系统留在浅色就会带进一块白底。勾的形状是 Resources/Styles 下的两份 SVG。 */
QCheckBox {
    spacing: 8px;
    color: #000000;
    min-height: 24px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    background-color: #FFFFFF;
    border: 2px solid #000000;
    border-radius: 5px;
}

QCheckBox::indicator:hover {
    border-color: #0B57D0;
}

QCheckBox::indicator:checked {
    background-color: #0B57D0;
    border-color: #0B57D0;
    image: url(:/styles/CheckmarkOnAccent.svg);
}

QCheckBox::indicator:disabled {
    background-color: #FFFFFF;
    border-color: #000000;
}

QCheckBox:disabled {
    color: #000000;
}

/* ---- 滑块：槽给一档描边（高对比度档靠这一档才看得见轨道），已走过的部分用主色 ---- */
QSlider::groove:horizontal {
    height: 6px;
    background-color: #FFFFFF;
    border: 2px solid #000000;
    border-radius: 4px;
}

QSlider::sub-page:horizontal {
    background-color: #0B57D0;
    border: 1px solid #0B57D0;
    border-radius: 4px;
}

QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -6px -2px;
    background-color: #0B57D0;
    border: 2px solid #FFFFFF;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    background-color: #08449E;
}

QSlider:disabled::groove:horizontal {
    background-color: #000000;
}

QSlider:disabled::sub-page:horizontal {
    background-color: #000000;
}

QSlider:disabled::handle:horizontal {
    background-color: #000000;
    border-color: #FFFFFF;
}

/* ---- 菜单与工具提示：弹层比卡片再圆一点，靠描边而不是阴影分层 ---- */
QMenu {
    background-color: #FFFFFF;
    border: 2px solid #000000;
    border-radius: 10px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 6px;
    color: #000000;
}

QMenu::item:selected {
    background-color: #D6E4FB;
    color: #000000;
}

QMenu::item:disabled {
    color: #000000;
}

QMenu::separator {
    height: 2px;
    background-color: #000000;
    margin: 4px 8px;
}

QToolTip {
    background-color: #FFFFFF;
    color: #000000;
    border: 2px solid #000000;
    border-radius: 6px;
    padding: 4px 8px;
}

/* ---- 列表：导航侧栏与历史列表共用一套项形状 ---- */
QListWidget {
    background-color: #FFFFFF;
    border: 2px solid #000000;
    border-radius: 10px;
    padding: 4px;
    outline: none;
}

QListWidget::item {
    min-height: 24px;
    padding: 4px 8px;
    margin: 1px 2px;
    border: 2px solid transparent;
    border-radius: 8px;
    color: #000000;
}

QListWidget::item:hover {
    background-color: #E0E0E0;
}

QListWidget::item:selected {
    background-color: #D6E4FB;
    border-color: #0B57D0;
    color: #000000;
}

QListWidget#settingsNav {
    background-color: transparent;
    border: none;
    padding: 0;
}

QListWidget#settingsNav::item {
    min-height: 32px;
}

/* ---- 文本区（识别结果） ---- */
QTextEdit {
    background-color: #FFFFFF;
    color: #000000;
    border: 2px solid #000000;
    border-radius: 10px;
    padding: 8px;
    selection-background-color: #FFE500;
    selection-color: #000000;
}

/* ---- 工具栏分段用的竖线，代码里按对象名给出 ---- */
QFrame#toolbarSeparator {
    background-color: #000000;
    max-width: 2px;
    min-width: 2px;
}

/* ---- 滚动条：细、无箭头、平时淡一档 ---- */
QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #000000;
    border-radius: 3px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #000000;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: #000000;
    border-radius: 3px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #000000;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background-color: transparent;
}
