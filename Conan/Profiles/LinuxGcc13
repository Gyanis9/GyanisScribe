# 容器内（Ubuntu 24.04 + GCC 13）的 Conan 默认档。
# 消费者是 scripts/container/*.sh：它们把 CONAN_DEFAULT_PROFILE_PATH 指到这份文件，
# 于是 conan_provider 在 configure 期检测到的就是这一档，而不是容器里那份自带的 default。
#
# 为什么不用 conan 自动检测的 default：它的 cppstd 是 gnu17（扩展开着、标准停在 C++17），
# 而本工程的硬指标是 C++23 且 CMAKE_CXX_EXTENSIONS=OFF。留成 gnu17 时 spdlog/gtest 会按
# C++17 编出来，链接期才在些奇怪的地方对不上——那时报错指向依赖库，看不出是档位选错了。
#
# 这里刻意不写 build_type：它由 CMake-Conan 按预设的 CMAKE_BUILD_TYPE 推。写死 Release 的话，
# Debug 预设也会领到 Release 版的依赖图，而本工程的「Debug 不领 Tesseract」正是按 build_type 分岔的。

[settings]
os=Linux
arch=x86_64
compiler=gcc
compiler.version=13
compiler.cppstd=23
compiler.libcxx=libstdc++11

[conf]
tools.cmake.cmaketoolchain:generator=Ninja

[buildenv]
CC=gcc-13
CXX=g++-13
